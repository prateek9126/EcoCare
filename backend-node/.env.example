# EcoCare Backend Environment Variables Example
PORT=8080
NODE_ENV=production

# PostgreSQL Connection String (Vercel Postgres / Neon / Supabase / Render)
DATABASE_URL=postgres://user:password@hostname:5432/dbname?sslmode=require

# Optional fallback variables
DB_HOST=localhost
DB_PORT=5432
DB_NAME=EVCharging
DB_USER=postgres
DB_PASSWORD=your_password_here

CORS_ORIGIN=*
